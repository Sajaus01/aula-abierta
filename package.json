{
  "name": "aula-abierta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de cursos, estudiantes y matrículas",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server/index.mjs && node --check public/app.js"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "pdfjs-dist": "6.3.289"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
