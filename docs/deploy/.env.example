# Nombre público cuyo DNS apunta al servidor. Sin https:// ni barra final.
DOMAIN=

# Solo se usan para crear el primer administrador si aún no existe uno.
# Cédula: entre 4 y 20 dígitos. Contraseña: al menos 12 caracteres.
ADMIN_DOCUMENT=
ADMIN_NAME=
ADMIN_PASSWORD=

# Cupo global opcional de adjuntos estudiantiles; por defecto 500 MiB, en bytes.
# Aumentarlo no amplía el disco contratado. Revisa antes el espacio disponible.
SUBMISSIONS_MAX_BYTES=524288000
